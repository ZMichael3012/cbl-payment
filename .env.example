# Local environment variables for cbl-payment.
HTTP_ADDR=:8030
GRPC_ADDR=:9030
METRICS_ADDR=:9230
PG_DSN=postgres://cbl:cbl@localhost:5432/payment?sslmode=disable
KAFKA_BROKERS=localhost:9092
# Creation flow (4.2): the clients are wired only when both addresses are set;
# without them CreatePayment/CancelPayment answer Unavailable fail-closed.
QUOTE_GRPC_ADDR=localhost:9070
CONNECTOR_GRPC_ADDR=localhost:9050
# Pay asset scales of the created invoices (ASSET:SCALE CSV); an unknown asset
# fails the creation closed.
PAYMENT_ASSET_DECIMALS=USDT:6,BTC:8,USDC:6
